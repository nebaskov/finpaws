# Copy to .env and fill in secrets. Every FinPaws setting (see app/config.py) is listed here.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finpaws

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-byte-random-string
JWT_ALGORITHM=HS256
JWT_TTL=86400

# ── LLM (OpenAI-compatible: OpenAI / OpenRouter / vLLM / Ollama / LM Studio) ──
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_RETRIES=2
AGENT_MAX_STEPS=8
# Client-side LLM rate limit: requests/second (0 = disabled) + bucket/burst size
LLM_RPS=0
LLM_RATE_LIMIT_BURST=1

# ── Embeddings (for the RAG knowledge base) ───────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...

# ── LLM-as-a-judge for deepeval (OpenAI-compatible; DeepSeek by default) ──────
JUDGE_MODEL=deepseek-chat
JUDGE_BASE_URL=https://api.deepseek.com/v1
JUDGE_API_KEY=sk-...
JUDGE_TEMPERATURE=0.0
# Silence deepeval telemetry/update pings (export this for it to take effect)
DEEPEVAL_TELEMETRY_OPT_OUT=YES
# Only needed if a deepeval metric is run without an explicit model
# OPENAI_API_KEY=sk-...

# ── Knowledge base (RAG vector store) ─────────────────────────────────────────
KB_BACKEND=chroma
KB_PATH=data/kb
KB_COLLECTION=finpaws-advice
KB_SEED_PATH=data/kb_seed
QDRANT_URL=http://localhost:6333

# ── Currency conversion ───────────────────────────────────────────────────────
CURRENCY_API_URL=https://api.exchangerate.host/convert
CURRENCY_TTL=3600

# ── hledger plain-text accounting mirror ──────────────────────────────────────
HLEDGER_BIN=hledger
HLEDGER_JOURNAL=data/finpaws.journal
HLEDGER_MIRROR=true
HLEDGER_TIMEOUT=10

# ── Logging (loguru) ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
LOG_BACKTRACE=false
LOG_DIAGNOSE=false

# ── Safety ────────────────────────────────────────────────────────────────────
PII_REDACT=true
SAFE_MODE=true
# Rule-based toxicity score in [0, 1]; safety.toxic = True when score ≥ this threshold.
TOXICITY_THRESHOLD=0.5

# ── Prometheus metrics (/metrics endpoint; scraped by docker-compose) ─────────
METRICS_ENABLED=true

# ── API rate limit (slowapi limit string, per client IP) ─────────────────────
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT=120/minute

# ── Langfuse LLM tracing (enabled when both keys are set) ─────────────────────
# Cloud: set the keys + LANGFUSE_HOST=https://cloud.langfuse.com, then `docker compose up`.
# Self-hosted: `make langfuse-up` sets pk-lf-finpaws / sk-lf-finpaws / http://langfuse-web:3000.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
